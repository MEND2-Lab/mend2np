{
    "metacols":{
        "id":"participant",
        "session":"session",
        "datetime":"date",
        "exp_name":"expName",
        "software_version":"psychopyVersion",
        "framerate":"frameRate",
        "os":"OS",
        "charity_name":"charity_name",
        "staff_name":"staff_name"
    },
    "blocks":{
        "practice":{
            "_comment":"Practice block uses the `p`-prefixed PsychoPy column names.",
            "metavars":{
                "phase":"practice"
            },
            "cols":{
                "trial":"ptrials.thisN",
                "benefactor":"pbenefactor",
                "prime":"pPrime",
                "probe_key":"pprobe_key_response.keys",
                "probe_rt":"pprobe_key_response.rt",
                "pre_probe_key":"ppre_key_response.keys",
                "pre_probe_rt":"ppre_key_response.rt",
                "_post_probe_note":"Practice has no post-probe response logger of its own — practice and real share post_probe_key_response.keys/.rt (the row mask separates them), so these two entries intentionally map the same columns as the real block does.",
                "post_probe_key":"post_probe_key_response.keys",
                "post_probe_rt":"post_probe_key_response.rt",
                "_onset_note":"Routine onsets on the global experiment clock. Used to re-reference post_probe_rt onto the probe clock; they are also emitted so the arithmetic can be checked.",
                "probe_onset":"pprobe.started",
                "post_probe_onset":"pjitter.started",
                "feedback_correct":"pFeedbackCorrect",
                "feedback_incorrect":"pFeedbackIncorrect",
                "feedback_spoiled":"pFeedbackSpoiled"
            }
        },
        "real":{
            "metavars":{
                "phase":"real"
            },
            "cols":{
                "trial":"trials.thisN",
                "benefactor":"benefactor",
                "prime":"Prime",
                "probe_response":"probe_response",
                "probe_key":"probe_key_response.keys",
                "probe_rt":"probe_key_response.rt",
                "pre_probe_key":"pre_key_response.keys",
                "pre_probe_rt":"pre_key_response.rt",
                "post_probe_key":"post_probe_key_response.keys",
                "post_probe_rt":"post_probe_key_response.rt",
                "_onset_note":"Routine onsets on the global experiment clock. Used to re-reference post_probe_rt onto the probe clock; they are also emitted so the arithmetic can be checked.",
                "probe_onset":"probe.started",
                "post_probe_onset":"jitter.started",
                "feedback_correct":"FeedbackCorrect",
                "feedback_incorrect":"FeedbackIncorrect",
                "feedback_spoiled":"FeedbackSpoiled",
                "probe_duration":"probe_duration",
                "self_earnings":"self_earnings",
                "charity_earnings":"charity_earnings"
            }
        }
    }
}
